{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "wanda-group-landing-pm4s.vercel.app" }],
      "destination": "https://www.wandagroups.com/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "wanda-group-landing-pm4s.vercel.app" }],
      "destination": "https://www.wandagroups.com/:path*",
      "statusCode": 301
    }
  ]
}
